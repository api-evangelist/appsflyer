          "id": "4b314633-7bae-4174-bd0b-5ed000039cd7",
          "name": "Send Event",
          "request": {
            "name": "Send Event",
            "description": {
              "content": "Use this API to send mobile events that occur outside the app from your servers to AppsFlyer.\n> ⚠️ \n> **JSON payload limitation** JSON payload size: up to 1KB\n\n> 📘 \n> **Encode URLs** - [Encode (percent) code reserved characters](https://tools.ietf.org/html/rfc3986#section-2.1) before forming the method URL. \n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "inappevent",
                ":app_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "app_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appsflyer_id\": \"<string>\",\n  \"eventName\": \"<string>\",\n  \"eventValue\": \"<json>\",\n  \"advertising_id\": \"<string>\",\n  \"oaid\": \"<string>\",\n  \"amazon_aid\": \"<string>\",\n  \"imei\": \"<string>\",\n  \"customer_user_id\": \"<string>\",\n  \"email_hashed\": \"<string>\",\n  \"phone_number_hashed\": \"<string>\",\n  \"phone_number_e164_hashed\": \"<string>\",\n  \"first_name_hashed\": \"<string>\",\n  \"last_name_hashed\": \"<string>\",\n  \"fb_login_id\": \"<string>\",\n  \"ip\": \"<string>\",\n  \"app_version_name\": \"<string>\",\n  \"app_store\": \"<string>\",\n  \"eventTime\": \"<dateTime>\",\n  \"eventCurrency\": \"<string>\",\n  \"bundleIdentifier\": \"<string>\",\n  \"sharing_filter\": [\n    \"<string>\"\n  ],\n  \"custom_dimension\": \"<string>\",\n  \"app_type\": \"<string>\",\n  \"custom_data\": \"<json>\",\n  \"os\": \"<string>\",\n  \"aie\": \"<boolean>\",\n  \"consent_data\": {\n    \"tcf\": {\n      \"policy_version\": \"<integer>\",\n      \"gdpr_applies\": \"<integer>\",\n      \"cmp_sdk_id\": \"<integer>\",\n      \"cmp_sdk_version\": \"<integer>\",\n      \"tcstring\": \"<string>\"\n    }\n  },\n  \"app_set_id\": {\n    \"scope\": \"<integer>\",\n    \"id\": \"<UUID>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
