                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "authorization",
                    "value": "<API Key>"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"request_id\": \"71dad7da-7926-40d8-9b15-b94a6d46e15a\",\n  \"device_ids\": [\n    {\n      \"type\": \"rida\",\n      \"value\": \"fa73d67d-f55c-5af3-883a-726253dc7d0e\"\n    },\n    {\n      \"type\": \"custom\",\n      \"value\": \"045f4137-57b7-45e6-8a45-c303101a086a\"\n    }\n  ],\n  \"device_model\": \"3920X\",\n  \"device_os_version\": \"9.3.0\",\n  \"event_name\": \"af_purchase\",\n  \"limit_ad_tracking\": true,\n  \"app_version\": \"1.0.5\",\n  \"customer_user_id\": \"15667737-366d-4994-ac8b-653fe6b2be4a\",\n  \"event_parameters\": {\n    \"af_revenue\": 1.99,\n    \"af_price\": 2.456,\n    \"af_currency\": \"MYR\"\n  },\n  \"event_custom_parameters\": \"<json>\"\n}",
                  "options": {
